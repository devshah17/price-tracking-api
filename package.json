{
  "name": "price-tracking-api",
  "version": "1.0.0",
  "description": "Production API for fetching ticker prices via Yahoo Finance with Gemini fallback",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "offline": "serverless offline",
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage prod"
  },
  "keywords": [
    "prices",
    "tickers",
    "yahoo-finance"
  ],
  "license": "ISC",
  "dependencies": {
    "@vendia/serverless-express": "^4.10.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "yahoo-finance2": "^3.14.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.0.0",
    "serverless": "^3.38.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-offline": "^13.3.3"
  }
}
